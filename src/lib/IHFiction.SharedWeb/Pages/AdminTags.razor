@using Microsoft.AspNetCore.Authorization
@implements IAsyncDisposable

@page "/admin/tags"

@attribute [Authorize(Roles = "admin")]
@inject AdminService AdminService

<PageTitle>Admin - Tags</PageTitle>

<NoIndex />

<section class="section">
    <div class="container">
        <h1 class="title">Tag Administration</h1>
        <p class="subtitle">Canonical tags, their synonyms, and published usage.</p>

        <div class="field">
            <div class="control">
                <input class="input" type="search" aria-label="Search tags" placeholder="Search tags..." value="@_search" disabled="@_isSaving" @oninput="SearchChangedAsync" />
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="container has-text-centered">
                <span class="icon is-large" aria-hidden="true">
                    <i class="fas fa-spinner fa-pulse fa-2x"></i>
                </span>
                <p>Loading tags...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="notification is-danger">
                <strong>Error:</strong> @_errorMessage
            </div>
        }
        else if (_tags is not null)
        {
            <div class="level mb-3">
                <div class="level-left">
                    @if (_selectedMergeTags.Count == 0)
                    {
                        <p class="help">Select two or more tags to merge.</p>
                    }
                    else
                    {
                        <p class="help"><strong>@_selectedMergeTags.Count selected:</strong> @string.Join(" + ", _selectedMergeTags.Select(tag => tag.DisplayFormat))</p>
                    }
                </div>
                <div class="level-right">
                    <button class="button is-warning" type="button" @onclick="BeginMergeSelected" disabled="@(_selectedMergeTags.Count < 2 || _isSaving)">
                        Merge selected
                    </button>
                </div>
            </div>
            <div class="is-clipped">
                <div class="table-container">
                    <table class="table is-fullwidth is-striped admin-tags-table">
                    <thead>
                        <tr>
                            <th><span class="is-sr-only">Select for merge</span></th>
                            <th>Tag</th>
                            <th class="is-hidden-mobile">Synonyms</th>
                            <th class="is-hidden-mobile">Published works</th>
                            <th><span class="is-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tag in _tags)
                        {
                            <tr @key="tag.TagId">
                                <td>
                                    <input type="checkbox"
                                           aria-label="Select @tag.DisplayFormat for merge"
                                           checked="@IsSelectedForMerge(tag)"
                                           disabled="@_isSaving"
                                           @onchange="args => ToggleMergeSelection(tag, args)" />
                                </td>
                                <td>
                                    @tag.DisplayFormat
                                    <div class="is-hidden-tablet">
                                        <p class="help">@tag.PublishedWorkCount published works</p>
                                        @if (tag.Synonyms.Count > 0)
                                        {
                                            <p class="help">Synonyms: @string.Join(", ", tag.Synonyms)</p>
                                        }
                                    </div>
                                </td>
                                <td class="is-hidden-mobile">@(tag.Synonyms.Count == 0 ? "—" : string.Join(", ", tag.Synonyms))</td>
                                <td class="is-hidden-mobile">@tag.PublishedWorkCount</td>
                                <td>
                                    <button class="button is-small has-background-link-soft has-text-link-bold has-tooltip-left"
                                            type="button" title="Rename" data-tooltip="Rename" aria-label="Rename @tag.DisplayFormat"
                                            @onclick="() => BeginEdit(tag)" disabled="@(_isSaving || _editingTag?.TagId == tag.TagId)">
                                        <span class="icon is-small"><i class="fas fa-pen" aria-hidden="true"></i></span>
                                    </button>
                                </td>
                            </tr>
                            @if (_editingTag?.TagId == tag.TagId)
                            {
                                <tr>
                                    <td colspan="5">
                                        <form @onsubmit="RenameAsync" @onsubmit:preventDefault="true">
                                            <fieldset disabled="@_isSaving">
                                                <legend class="label">Rename @tag.DisplayFormat</legend>
                                                <div class="columns">
                                                    <div class="column"><label class="label" for="rename-category">Category</label><input id="rename-category" class="input" maxlength="50" required @bind="_category" @bind:event="oninput" /></div>
                                                    <div class="column"><label class="label" for="rename-subcategory">Subcategory</label><input id="rename-subcategory" class="input" maxlength="50" @bind="_subcategory" @bind:event="oninput" /></div>
                                                    <div class="column"><label class="label" for="rename-value">Value</label><input id="rename-value" class="input" maxlength="50" required @bind="_value" @bind:event="oninput" /></div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(_renameErrorMessage))
                                                {
                                                    <p class="help is-danger" role="alert">@_renameErrorMessage</p>
                                                }
                                                <div class="buttons mt-3">
                                                    <button class="button is-link @(_isSaving ? "is-loading" : "")" type="submit" disabled="@(!CanRename)">Save</button>
                                                    <button class="button has-background-light-soft has-text-light-bold" type="button" @onclick="CancelAction">Cancel</button>
                                                </div>
                                            </fieldset>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    </table>
                </div>
            </div>

            @if (_tags.Count == 0)
            {
                <p>No tags found.</p>
            }

            @if (_totalPages > 1)
            {
                <nav class="pagination mt-4" aria-label="Tag pages">
                    <button class="pagination-previous" @onclick="PreviousPageAsync" disabled="@(_page <= 1 || _isLoading || _isSaving)">Previous</button>
                    <button class="pagination-next" @onclick="NextPageAsync" disabled="@(_page >= _totalPages || _isLoading || _isSaving)">Next</button>
                    <span class="pagination-list">Page @_page of @_totalPages</span>
                </nav>
            }
        }

        @if (_isMergeDialogOpen)
        {
            <div class="modal is-active" role="dialog" aria-modal="true" aria-labelledby="merge-dialog-title">
                <div class="modal-background" @onclick="CancelAction"></div>
                <div class="modal-card">
                    <header class="modal-card-head">
                        <h2 id="merge-dialog-title" class="modal-card-title">Merge tag families</h2>
                        <button class="delete" type="button" aria-label="Close merge dialog" @onclick="CancelAction" disabled="@_isSaving"></button>
                    </header>
                    <section class="modal-card-body">
                        <div class="notification has-background-warning-soft has-text-warning-bold">All names, synonyms, and work relationships will move under the canonical tag you select. This action cannot be undone from this screen.</div>
                        @if (!string.IsNullOrWhiteSpace(_mergeErrorMessage))
                        {
                            <div class="notification is-danger"><strong>Error:</strong> @_mergeErrorMessage</div>
                        }
                        <fieldset class="field">
                            <legend class="label">Keep as canonical</legend>
                            @foreach (var tag in _selectedMergeTags)
                            {
                                <label @key="tag.TagId" class="box is-clickable mb-3">
                                    <input type="radio" name="canonical-tag" value="@tag.TagId" checked="@(_mergeCanonicalTagId == tag.TagId)" @onchange="() => _mergeCanonicalTagId = tag.TagId" />
                                    <strong class="ml-2">@tag.DisplayFormat</strong>
                                    <span class="is-block ml-5 has-text-grey">@tag.PublishedWorkCount published works; @tag.Synonyms.Count synonyms</span>
                                </label>
                            }
                        </fieldset>
                        <div class="field">
                            <label class="label" for="merge-reason">Reason</label>
                            <textarea id="merge-reason" class="textarea" @bind="_reason" @bind:event="oninput"></textarea>
                        </div>
                    </section>
                    <footer class="modal-card-foot">
                        <div class="buttons mb-0">
                            <button class="button is-warning" @onclick="MergeAsync" disabled="@(_isSaving || !CanMerge)">Confirm merge</button>
                            <button class="button has-background-light-soft has-text-light-bold" @onclick="CancelAction" disabled="@_isSaving">Cancel</button>
                        </div>
                    </footer>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _search = "";
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private ICollection<LinkedOfAdminTagItem>? _tags;
    private LinkedOfAdminTagItem? _editingTag;
    private readonly List<LinkedOfAdminTagItem> _selectedMergeTags = [];
    private bool _isMergeDialogOpen;
    private Ulid? _mergeCanonicalTagId;
    private string? _mergeErrorMessage;
    private string? _renameErrorMessage;
    private string _category = "";
    private string? _subcategory;
    private string _value = "";
    private string _reason = "";
    private int _page = 1;
    private int _totalPages = 1;
    private CancellationTokenSource? _searchCts;

    private bool CanRename => !string.IsNullOrWhiteSpace(_category) && !string.IsNullOrWhiteSpace(_value)
        && (_category.Trim() != _editingTag?.Category || (_subcategory?.Trim() ?? "") != (_editingTag?.Subcategory ?? "") || _value.Trim() != _editingTag?.Value);
    private bool CanMerge => _selectedMergeTags.Count >= 2 && _mergeCanonicalTagId is not null && _reason.Trim().Length >= 3;

    protected override async Task OnInitializedAsync()
    {
        await LoadTagsAsync();
    }

    private async Task LoadTagsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await AdminService.ListAdminTagsAsync(search: string.IsNullOrWhiteSpace(_search) ? null : _search, page: _page);

        if (result.IsSuccess)
        {
            _tags = result.Value.Data;
            _totalPages = Math.Max(1, result.Value.TotalPages);
        }
        else
        {
            _errorMessage = result.DomainError.Description;
        }

        _isLoading = false;
    }

    private async Task SearchChangedAsync(ChangeEventArgs args)
    {
        if (_isSaving) return;
        _editingTag = null;
        _search = args.Value?.ToString() ?? "";
        _page = 1;
        if (_searchCts is not null) await _searchCts.CancelAsync();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchCts.Token);
            await LoadTagsAsync();
        }
        catch (OperationCanceledException) when (_searchCts.IsCancellationRequested)
        {
            return;
        }
    }

    private void BeginEdit(LinkedOfAdminTagItem tag)
    {
        _editingTag = tag;
        _isMergeDialogOpen = false;
        _category = tag.Category;
        _subcategory = tag.Subcategory;
        _value = tag.Value;
        _reason = "";
        _renameErrorMessage = null;
        _errorMessage = null;
    }

    private bool IsSelectedForMerge(LinkedOfAdminTagItem tag) =>
        _selectedMergeTags.Any(selected => selected.TagId == tag.TagId);

    private void ToggleMergeSelection(LinkedOfAdminTagItem tag, ChangeEventArgs args)
    {
        var selected = args.Value is true;
        if (selected && !IsSelectedForMerge(tag))
        {
            _selectedMergeTags.Add(tag);
        }
        else if (!selected)
        {
            _selectedMergeTags.RemoveAll(candidate => candidate.TagId == tag.TagId);
        }
    }

    private void BeginMergeSelected()
    {
        if (_selectedMergeTags.Count < 2) return;
        _editingTag = null;
        _mergeCanonicalTagId = null;
        _mergeErrorMessage = null;
        _reason = "";
        _errorMessage = null;
        _isMergeDialogOpen = true;
    }

    private async Task RenameAsync()
    {
        if (_editingTag is null || !CanRename) return;
        var editingTagId = _editingTag.TagId;
        _isSaving = true;
        var result = await AdminService.RenameCanonicalTagAsync(editingTagId, _category.Trim(), _subcategory?.Trim(), _value.Trim(), "Inline rename from tag administration.");
        _isSaving = false;
        if (result.IsFailure) { _renameErrorMessage = result.DomainError.Description; return; }
        _selectedMergeTags.RemoveAll(tag => tag.TagId == editingTagId);
        CancelAction();
        await LoadTagsAsync();
    }

    private async Task MergeAsync()
    {
        if (!CanMerge) return;
        var canonicalTag = _selectedMergeTags.Single(tag => tag.TagId == _mergeCanonicalTagId);
        var sourceTagIds = _selectedMergeTags.Where(tag => tag.TagId != canonicalTag.TagId).Select(tag => tag.TagId).ToArray();
        _isSaving = true;
        var result = await AdminService.MergeCanonicalTagsAsync(canonicalTag.TagId, sourceTagIds, _reason);
        _isSaving = false;
        if (result.IsFailure) { _mergeErrorMessage = result.DomainError.Description; return; }
        _selectedMergeTags.Clear();
        CancelAction();
        await LoadTagsAsync();
    }

    private void CancelAction()
    {
        _editingTag = null;
        _isMergeDialogOpen = false;
        _mergeCanonicalTagId = null;
        _mergeErrorMessage = null;
        _renameErrorMessage = null;
        _reason = "";
    }

    private async Task PreviousPageAsync() { if (_page > 1 && !_isSaving) { _editingTag = null; _page--; await LoadTagsAsync(); } }
    private async Task NextPageAsync() { if (_page < _totalPages && !_isSaving) { _editingTag = null; _page++; await LoadTagsAsync(); } }

    public ValueTask DisposeAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
