@using Microsoft.AspNetCore.Components.Web
@using IHFiction.SharedWeb.Services
@implements IAsyncDisposable
@inject StoryService StoryService

<div class="field">
    <label class="label" for="story-tags-input">Tags</label>
    <div class="control">
        <TagDisplay Items="@SelectedDisplayTags" Removable Remove="RemoveTag" />

        <div class="field">
            <div class="control">
                <textarea id="story-tags-input" class="textarea" rows="3" value="@_searchText" @oninput="HandleInput" placeholder="Enter tags separated by new lines, commas, or semicolons"></textarea>
            </div>
        </div>

        <div class="field is-grouped is-grouped-right mt-2 mb-0">
            <div class="control">
                <button class="button is-link" type="button" @onclick="AddTypedTag" disabled="@string.IsNullOrWhiteSpace(_searchText)">Add tags</button>
            </div>
        </div>

        @if (_isLoading)
        {
            <p class="help">Searching canonical tags…</p>
        }
        else if (_suggestions.Count > 0)
        {
            <div class="dropdown is-active is-block">
                <div class="dropdown-menu is-fullwidth" role="menu">
                    <div class="dropdown-content">
                        @foreach (var tag in _suggestions)
                        {
                            <a @key="tag.TagId" class="dropdown-item" @onclick="() => SelectSuggestion(tag)">
                                <strong>@tag.DisplayFormat</strong>
                                <span class="has-text-grey">(@tag.StoryCount stories)</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_searchError))
        {
            <p class="help has-text-danger">@_searchError</p>
        }
    </div>
    <p class="help">Separate tags with new lines, commas, or semicolons. Spaces remain part of a tag. @SelectedTags.Count / @MaximumTagCount tags selected.</p>
</div>

@code {
    private readonly List<LinkedOfListTagsItem> _suggestions = [];
    private string _searchText = string.Empty;
    private bool _isLoading;
    private string? _searchError;
    private CancellationTokenSource? _searchCts;
    private const int MaximumTagCount = 200;

    private IEnumerable<TagDisplayItem> SelectedDisplayTags => SelectedTags.Select(TagDisplayItem.FromText);

    [Parameter, EditorRequired] public ICollection<string> SelectedTags { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyCollection<string>> SelectedTagsChanged { get; set; }

    private async Task HandleInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (_searchCts is not null)
        {
            await _searchCts.CancelAsync();
        }
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();

        if (string.IsNullOrWhiteSpace(_searchText) || _searchText.IndexOfAny([',', ';', '\r', '\n']) >= 0)
        {
            _suggestions.Clear();
            _isLoading = false;
            return;
        }

        _isLoading = true;
        _searchError = null;
        StateHasChanged();

        try
        {
            await Task.Delay(250, _searchCts.Token);
            var result = await StoryService.ListTagsAsync(_searchText.Trim(), 8, _searchCts.Token);
            if (result.IsSuccess)
            {
                _suggestions.Clear();
                _suggestions.AddRange(result.Value.Data);
            }
            else
            {
                _searchError = result.DomainError.Description;
            }
        }
        catch (OperationCanceledException) when (_searchCts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectSuggestion(LinkedOfListTagsItem tag)
    {
        AddTag(tag.DisplayFormat);
        _searchText = string.Empty;
        _suggestions.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddTypedTag()
    {
        var tagTexts = TagInputParser.Parse(_searchText);
        if (tagTexts.Count == 0)
        {
            return;
        }

        var existingKeys = SelectedTags.Select(TagInputParser.Normalize).ToHashSet(StringComparer.Ordinal);
        var newTags = tagTexts.Where(tag => !existingKeys.Contains(TagInputParser.Normalize(tag))).ToArray();
        if (SelectedTags.Count + newTags.Length > MaximumTagCount)
        {
            _searchError = $"A story can have at most {MaximumTagCount} tags.";
            return;
        }

        _searchError = null;
        foreach (var tagText in newTags)
        {
            AddTag(tagText);
        }
        _searchText = string.Empty;
        _suggestions.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private void AddTag(string tagText)
    {
        var normalizedKey = TagInputParser.Normalize(tagText);
        if (SelectedTags.Count >= MaximumTagCount ||
            SelectedTags.Any(tag => string.Equals(TagInputParser.Normalize(tag), normalizedKey, StringComparison.Ordinal)))
        {
            return;
        }

        SelectedTags.Add(tagText);
        _ = SelectedTagsChanged.InvokeAsync(SelectedTags.ToArray());
    }

    private async Task RemoveTag(string tagText)
    {
        if (!SelectedTags.Remove(tagText))
        {
            return;
        }

        await SelectedTagsChanged.InvokeAsync(SelectedTags.ToArray());
    }

    public ValueTask DisposeAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
