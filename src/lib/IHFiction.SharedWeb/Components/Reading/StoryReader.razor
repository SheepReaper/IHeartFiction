@inherits CancellableComponent
@inject MarkdownReaderService ReaderService
@inject PersistentComponentState ApplicationState
@inject ReaderProgressService ReaderProgressService
@inject ReadTrackingService ReadTrackingService
@inject ThemeService theme
@inject MarkdownPipeline mdp
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="section">
        <div class="content has-text-centered">
            <span class="icon is-large">
                <i class="fas fa-spinner fa-pulse fa-2x"></i>
            </span>
            <p>Loading...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="section">
        <div class="container">
            <div class="notification is-danger">
                <strong>Error:</strong> @errorMessage
            </div>
        </div>
    </div>
}
else if (Meta is not null)
{
    var orderedChildren = BuildNavigationChapters().ToList();
    var currentChapterIndex = orderedChildren.FindIndex(chapter => chapter.Id == Meta.Id.ToString());
    var currentChapter = currentChapterIndex >= 0 ? orderedChildren[currentChapterIndex] : null;
    var nextChapter = currentChapterIndex >= 0 && currentChapterIndex < orderedChildren.Count - 1
        ? orderedChildren[currentChapterIndex + 1]
        : null;
    var isCrossBookTransition =
        nextChapter is not null
        && currentChapter is not null
        && !string.IsNullOrWhiteSpace(nextChapter.BookTitle)
        && !string.Equals(nextChapter.BookTitle, currentChapter.BookTitle, StringComparison.OrdinalIgnoreCase);
    var isEndOfStory = Meta.WorkType == "Chapter" && nextChapter is null && orderedChildren.Count > 0;

    <div class="section" @key="WorkId">
        <div class="container">
            <AppBreadcrumbs Items="@BreadcrumbItems" />
            <div class="level ihf-reader-header">
                <div class="level-left">
                    <div class="level-item">
                        <div>
                            <h1 class="title is-4 mb-1">@Meta.Title</h1>
                            @if (!string.IsNullOrWhiteSpace(Byline))
                            {
                                <p class="subtitle is-6 mb-0">@Byline</p>
                            }
                            <p class="is-size-7 has-text-grey" title="@($"{Meta.ReadCount:N0} reads")">
                                <span class="icon is-small"><i class="fas fa-eye" aria-hidden="true"></i></span>
                                <span>@ReadCountFormatter.Format(Meta.ReadCount) reads</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="level-right">
                    <div class="level-item">
                        <div class="buttons">
                            @if (orderedChildren.Count > 1 && Meta.WorkType == "Chapter")
                            {
                                <ChapterNavigation CurrentChapterId="@Meta.Id.ToString()" Chapters="@orderedChildren" />
                            }
                            @if (Meta.StoryId is not null)
                            {
                                <a href="/stories/@Meta.StoryId" class="button has-background-info-soft has-text-info-bold">
                                    <span class="icon">
                                        <i class="fas fa-info-circle"></i>
                                    </span>
                                    <span>Story Details</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (content is not null)
            {
                <div class="content">
                    @if (!string.IsNullOrWhiteSpace(content.Note1))
                    {
                        <div class="message is-info">
                            <div class="message-header">
                                <p>Author's Notes</p>
                            </div>
                            <div class="message-body">
                                <div class="content">@((MarkupString)Markdown.ToHtml(content.Note1, mdp))</div>
                            </div>
                        </div>
                    }

                    <div class="box content ihf-reader-body" data-work-id="@WorkId" @ref="readerElement">
                        @((MarkupString)Markdown.ToHtml(content.Content, mdp))
                    </div>

                    @if (!string.IsNullOrWhiteSpace(content.Note2))
                    {
                        <div class="message is-info">
                            <div class="message-header">
                                <p>Author's Notes</p>
                            </div>
                            <div class="message-body">
                                <div class="content">@((MarkupString)Markdown.ToHtml(content.Note2, mdp))</div>
                            </div>
                        </div>
                    }

                    @if (isCrossBookTransition && nextChapter is not null && currentChapter is not null)
                    {
                        <div class="notification has-background-info-soft has-text-info-bold">
                            <p>
                                You finished @currentChapter.BookTitle. Next up: @nextChapter.BookTitle.
                            </p>
                            <p class="mt-2">
                                <a class="button has-background-primary-soft has-text-primary-bold"
                                   href="@ReadHref(nextChapter.Id)">
                                    Continue to @nextChapter.BookTitle
                                </a>
                            </p>
                        </div>
                    }
                    else if (isEndOfStory)
                    {
                        <div class="notification has-background-success-soft has-text-success-bold">
                            <p>You've reached the end of this story.</p>
                            @if (Meta.StoryId is not null)
                            {
                                <p class="mt-2">
                                    <a class="button has-background-info-soft has-text-info-bold" href="/stories/@Meta.StoryId">
                                        Back to Story Details
                                    </a>
                                </p>
                            }
                        </div>
                    }

                    <div class="level mt-6">
                        <div class="level-left">
                            <div class="level-item">
                                <ChapterNavigation CurrentChapterId="@Meta.Id.ToString()" Chapters="@orderedChildren" ShowLabels="true" />
                            </div>
                        </div>
                        <div class="level-right">
                            <div class="level-item">
                                <p class="is-size-7">
                                    Last updated: @content.ContentUpdatedAt.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (Meta.IsDirectlyReadable)
            {
                <div class="content has-text-centered">
                    <span class="icon is-large">
                        <i class="fas fa-file-alt fa-3x"></i>
                    </span>
                    <h2 class="title is-4">No content available</h2>
                    <p>This work doesn't have any content yet.</p>
                </div>
            }
            else
            {
                <div class="content has-text-centered">
                    <span class="icon is-large">
                        <i class="fas fa-spinner fa-pulse fa-2x"></i>
                    </span>
                    <p>Finding your place...</p>
                </div>
            }
        </div>
    </div>
}

<script type="speculationrules" nonce="@Nonce">
    {
        "prerender": [
            {
                "source": "document",
                "where": {
                    "href_matches": "/read/*"
                },
                "eagerness": "eager"
            }
        ]
    }
</script>

@code {
    [Parameter, EditorRequired] public string WorkId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public LinkedOfGetPublishedWorkMetaResponse Meta { get; set; } = new();

    [CascadingParameter(Name = HttpContextItemKey)]
    private string? Nonce { get; set; }

    private MarkdownReaderModel? reader;
    private LinkedOfGetPublishedWorkContentResponse? content => reader?.Content;
    private bool isLoading = true;
    private string? errorMessage;
    private string? appliedParameterKey;
    private bool _disposed;
    private ElementReference readerElement;
    private IJSObjectReference? readTrackingModule;
    private DotNetObjectReference<StoryReader>? dotNetReference;
    private string? observedWorkId;
    private string? observedElementId;
    private PersistingComponentStateSubscription persistingSubscription;
    private long loadGeneration;

    private string? Byline => Meta.Authors.Any()
        ? $"by {string.Join(", ", Meta.Authors.Select(a => a.Name))}"
        : null;

    protected override void OnInitialized()
    {
        theme.ThemeChanged += OnThemeChanged;
        persistingSubscription = ApplicationState.RegisterOnPersisting(() =>
        {
            if (reader is not null && !isLoading)
                ApplicationState.PersistAsJson(BuildStateKey(), reader);
            return Task.CompletedTask;
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        var parameterKey = BuildParameterKey();
        if (appliedParameterKey == parameterKey) return;
        appliedParameterKey = parameterKey;
        var generation = ++loadGeneration;
        reader = null;
        errorMessage = null;
        isLoading = true;
        try
        {
            if (ApplicationState.TryTakeFromJson<MarkdownReaderModel>(BuildStateKey(), out var persisted)
                && persisted is not null)
            {
                reader = persisted;
            }
            else
            {
                var result = await ReaderService.ResolveAsync(WorkId, Meta, CancellationToken);
                if (generation != loadGeneration || _disposed) return;
                if (result.IsSuccess) reader = result.Value;
                else errorMessage = result.DomainError.Description;
            }
        }
        catch (OperationCanceledException) when (CancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            if (generation != loadGeneration || _disposed) return;
            errorMessage = "This work's content could not be loaded. Please try again.";
        }
        if (generation == loadGeneration) isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (reader is null || isLoading) return;
        if (observedWorkId != WorkId || observedElementId != readerElement.Id)
        {
            try { await StartReadObservationAsync(); }
            catch (JSException) { /* The server-rendered body remains readable. */ }
            catch (InvalidOperationException) { /* Interactivity is unavailable. */ }
        }
    }

    private string BuildStateKey() => $"StoryReader:Resolved:{WorkId}";

    private async Task StartReadObservationAsync()
    {
        if (string.IsNullOrEmpty(readerElement.Id)) return;
        var workId = WorkId;
        var element = readerElement;
        var generation = loadGeneration;
        readTrackingModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/IHFiction.SharedWeb/Components/Reading/StoryReader.razor.js");
        if (_disposed || isLoading || generation != loadGeneration || element.Id != readerElement.Id) return;
        dotNetReference ??= DotNetObjectReference.Create(this);
        // A detached or replaced body must remain retryable on the next render.
        var attached = await readTrackingModule.InvokeAsync<bool>("observe", element, dotNetReference, workId);
        if (attached && !_disposed && generation == loadGeneration && element.Id == readerElement.Id)
        {
            observedWorkId = workId;
            observedElementId = element.Id;
        }
    }

    [JSInvokable]
    public async Task OnQualifiedRead(string observedId, int activeSeconds)
    {
        if (isLoading || reader is null || observedId != WorkId
            || !Ulid.TryParse(observedId, out var workId)) return;
        var qualifiedMeta = Meta;

        var result = await ReadTrackingService.RecordQualifiedReadAsync(workId, activeSeconds, CancellationToken);
        if (result.IsSuccess && qualifiedMeta.WorkType == "Chapter" && qualifiedMeta.StoryId is { } storyId)
        {
            await ReaderProgressService.SetLastReadChapterIdAsync(storyId.ToString(), observedId);
        }
    }

    private IEnumerable<ReaderChapterNavItem> BuildNavigationChapters()
    {
        return Meta?.ReadableChildren?
            .OrderBy(child => child.BookId?.ToString() ?? string.Empty)
            .ThenBy(child => child.Order)
            .Select(child => new ReaderChapterNavItem(
                child.Id.ToString(),
                child.Title,
                child.Order,
                child.BookTitle,
                child.ReadCount))
            .ToList() ?? [];
    }

    private void OnThemeChanged(object? sender, ThemeChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        if (_disposed)
        {
            return;
        }

        persistingSubscription.Dispose();
        loadGeneration++;
        theme.ThemeChanged -= OnThemeChanged;
        if (readTrackingModule is not null)
        {
            try
            {
                await readTrackingModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already gone; client-side observation owns its cleanup.
                observedWorkId = null;
            }
        }
        dotNetReference?.Dispose();
        _disposed = true;

        await base.DisposeAsyncCore();
    }

    private static string ReadHref(string workId) => $"/read/{workId}";

    private IReadOnlyList<BreadcrumbItem> BreadcrumbItems
    {
        get
        {
            if (Meta is null) return [];

            if (Meta.WorkType is "Chapter" or "Book" && Meta.StoryId is not null && Meta.StoryId != Meta.Id)
            {
                return
                [
                    new("Home", "/"),
                    new("Stories", "/stories"),
                    new(Meta.StoryTitle ?? "Story", $"/stories/{Meta.StoryId}"),
                    new(Meta.Title, null, IsActive: true)
                ];
            }

            return
            [
                new("Home", "/"),
                new("Stories", "/stories"),
                new(Meta.Title, null, IsActive: true)
            ];
        }
    }

    private string BuildParameterKey() => $"{WorkId}:{Meta?.Id.ToString() ?? "none"}";
}
