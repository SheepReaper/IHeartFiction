@using Microsoft.Extensions.Options
@using IHFiction.SharedKernel.Notifications

@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject IOptions<WebPushOptions> WebPushOptions

@implements IAsyncDisposable

@if (_loaded)
{
    <div>
        <button class="button @ButtonClass is-fullwidth" disabled="@(_submitting || !IsPublished)"
                @onclick="ToggleFollowAsync">
            <span class="icon" aria-hidden="true">
                <i class="fas @(_isFollowing ? "fa-bookmark" : "fa-book-medical")"></i>
            </span>
            <span>@ButtonText</span>
        </button>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="help is-danger mt-2">@_error</p>
        }
    </div>
}
else
{
    <button class="button is-fullwidth" disabled>
        <span class="icon" aria-hidden="true"><i class="fas fa-spinner fa-spin"></i></span>
        <span>Loading</span>
    </button>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [Parameter, EditorRequired] public Ulid StoryId { get; set; }
    [Parameter] public bool IsPublished { get; set; } = true;

    private Task<AuthenticationState>? _loadedAuthenticationState;
    private bool _interactive;
    private int _lookupGeneration;
    private bool _loaded;
    private bool _isAuthenticated;
    private bool _isFollowing;
    private bool _submitting;
    private string? _error;
    private Ulid _storyId;

    private string ButtonClass => _isFollowing
        ? "has-background-danger-soft has-text-danger-bold"
        : "has-background-link-soft has-text-link-bold";

    private IJSObjectReference? module;

    private string ButtonText
    {
        get
        {
            if (!IsPublished)
            {
                return "Available After Publish";
            }

            return _isFollowing ? "Unfollow Story" : "Follow Story";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/IHFiction.SharedWeb/Layout/MainLayout.razor.js");
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (StoryId == Ulid.Empty)
        {
            _error = "Invalid story identifier.";
            _loaded = true;
            StateHasChanged();
            return;
        }

        _storyId = StoryId;

        _interactive = true;
        await LoadFollowStateAsync();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_interactive && _loadedAuthenticationState != AuthenticationState)
            await LoadFollowStateAsync();
    }

    private async Task LoadFollowStateAsync()
    {
        var generation = ++_lookupGeneration;
        var authenticationTask = AuthenticationState;
        _loadedAuthenticationState = authenticationTask;
        _loaded = false;
        _error = null;
        var authState = await authenticationTask;
        if (generation != _lookupGeneration || authenticationTask != AuthenticationState) return;
        var isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        var isFollowing = false;
        string? error = null;
        if (IsPublished)
        {
            var result = await NotificationService.IsStoryFollowedAsync(_storyId, isAuthenticated);
            if (result.IsSuccess) isFollowing = result.Value;
            else error = result.DomainError.Description;
        }
        if (generation != _lookupGeneration || authenticationTask != AuthenticationState) return;
        _isFollowing = isFollowing;
        _error = error;
        _isAuthenticated = isAuthenticated;
        _loaded = true;
    }

    private async Task ToggleFollowAsync()
    {
        if (!_loaded || _loadedAuthenticationState != AuthenticationState) return;
        _error = null;
        _submitting = true;

        try
        {
            if (!_isFollowing)
            {
                if (module is null)
                {
                    _error = "Notifications are unavailable right now.";
                    return;
                }

                var subscription = await module.InvokeAsync<BrowserPushSubscription?>("requestSubscription", WebPushOptions.Value.PublicKey);
                if (subscription is null)
                {
                    _error = "Notifications are not available or permission was not granted.";
                    return;
                }

                var subscriptionResult = await NotificationService.RegisterPushSubscriptionAsync(subscription, _isAuthenticated);
                if (subscriptionResult.IsFailure)
                {
                    _error = subscriptionResult.DomainError.Description;
                    return;
                }
            }

            var result = _isFollowing
                ? await NotificationService.UnfollowStoryAsync(_storyId, _isAuthenticated)
                : await NotificationService.FollowStoryAsync(_storyId, _isAuthenticated);

            if (result.IsSuccess)
            {
                _isFollowing = !_isFollowing;
            }
            else
            {
                _error = result.DomainError.Description;
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended while requesting a subscription.
        }
        catch (JSException)
        {
            _error = "Notifications are unavailable right now. Please try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The JS runtime is already disposed, so we can ignore this exception.
            }
        }
    }
}
