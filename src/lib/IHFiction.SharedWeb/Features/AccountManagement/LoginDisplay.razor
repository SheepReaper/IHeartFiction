@inject NavigationManager Navigation
@inject LoaderService LoaderService
@inject AccountService AccountService
@inject AuthenticationStateProvider AuthenticationStateProvider

@using System.Security.Cryptography
@using System.Text

<AuthorizeView>
    <Authorized>
        <div class="navbar-item has-dropdown @(_isMenuOpen ? "is-active" : string.Empty)">
            <a class="navbar-link" role="button" aria-label="User account menu" aria-haspopup="true" aria-expanded="@_isMenuOpen" tabindex="0" @onclick="ToggleMenu" @onkeydown="HandleMenuKeydown">
                @if (!string.IsNullOrEmpty(_avatarUrl))
                {
                    <figure class="image is-24x24">
                        <img class="is-rounded" src="@_avatarUrl" alt="@context.User.Identity?.Name" />
                    </figure>
                }
                else
                {
                    @(context.User.Identity?.Name)
                }
            </a>

            <div class="navbar-dropdown">
                <a class="navbar-item" @onclick="OnAccountSettingsClick">
                    Account Settings
                </a>
                <hr class="navbar-divider" />
                <form action="authentication/logout" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@(LogoutReturnUrl ?? new Uri(Navigation.BaseUri).AbsolutePath)" />
                    <button type="submit" class="navbar-item button is-ghost" disabled="@_loading">
                        Log out
                    </button>
                </form>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="buttons">
            <a class="@(_loading ? "button is-primary is-loading" : "button is-primary")" role="button" href="@SignUpUrl" @onclick="OnSignUpClick" aria-disabled="@_loading">
                <strong>Sign up</strong>
            </a>
            <a class="@(_loading ? "button has-background-link-soft has-text-link-bold is-loading" : "button has-background-link-soft has-text-link-bold")" role="button" href="@LoginUrl" @onclick="OnLoginClick" aria-disabled="@_loading">
                Log in
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter(Name = "LogoutReturnUrl")]
    public string? LogoutReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Parameter]
    public EventCallback OnActionInvoked { get; set; }

    private bool _loading;
    private string? _avatarUrl;
    private bool _isMenuOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var result = await AccountService.GetUserProfileAsync();
        if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.Value.GravatarEmail))
        {
            _avatarUrl = BuildGravatarUrl(result.Value.GravatarEmail);
            StateHasChanged();
        }
    }

    private static string? BuildGravatarUrl(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return null;
        var normalized = email.Trim().ToLowerInvariant();
        var hashBytes = SHA256.HashData(Encoding.UTF8.GetBytes(normalized));
        var hash = Convert.ToHexStringLower(hashBytes);
        return $"https://www.gravatar.com/avatar/{hash}?s=24&d=mp&r=g";
    }

    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }

    private void CloseMenu()
    {
        _isMenuOpen = false;
    }

    private void HandleMenuKeydown(KeyboardEventArgs e)
    {
        // Close menu on Escape key
        if (e.Key == "Escape" && _isMenuOpen)
        {
            CloseMenu();
        }
        // Toggle menu on Enter or Space key
        else if ((e.Key == "Enter" || e.Key == " ") && !_isMenuOpen)
        {
            ToggleMenu();
        }
    }

    private string LoginUrl => BuildAuthUrl("/authentication/login");

    private string SignUpUrl => BuildAuthUrl("/authentication/register");

    private string BuildAuthUrl(string path)
    {
        var target = ReturnUrl;
        if (string.IsNullOrWhiteSpace(target))
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (!string.IsNullOrWhiteSpace(relative) && !relative.StartsWith("authentication", StringComparison.OrdinalIgnoreCase))
            {
                target = "/" + relative.TrimStart('/');
            }
        }

        if (string.IsNullOrWhiteSpace(target) || string.Equals(target, "/", StringComparison.Ordinal))
        {
            return path;
        }

        return $"{path}?returnUrl={Uri.EscapeDataString(target)}";
    }

    private void OnSignUpClick()
    {
        _loading = true;
        LoaderService.Show();
        Navigation.NavigateTo(SignUpUrl, forceLoad: true);
    }

    private void OnLoginClick()
    {
        _loading = true;
        LoaderService.Show();
        Navigation.NavigateTo(LoginUrl, forceLoad: true);
    }

    private async Task OnAccountSettingsClick()
    {
        CloseMenu();
        await NotifyActionInvokedAsync();
        Navigation.NavigateTo("account/settings");
    }

    private Task NotifyActionInvokedAsync()
    {
        return OnActionInvoked.HasDelegate
            ? OnActionInvoked.InvokeAsync()
            : Task.CompletedTask;
    }
}
