{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "https://localhost.localdomain,https://localhost",
  "BaseUrl": "https://api.iheartfiction.net",
  "AgentAuth": {
    "Issuer": "https://api.iheartfiction.net",
    "SkillUri": "https://api.iheartfiction.net/auth.md",
    "Audience": "fiction-api",
    "SigningKeyId": "agent-auth-1",
    "ClaimVerificationUri": "https://iheartfiction.net/agent/claim",
    "ProviderAssertionMaxAge": "01:00:00",
    "ServiceAssertionLifetime": "00:15:00",
    "AccessTokenLifetime": "01:00:00",
    "ClaimLifetime": "00:10:00",
    "ClaimPollIntervalSeconds": 5,
    "TrustedProviders": [],
    "PreviousVerificationKeys": []
  },
  "KeycloakAdminClientOptions": {
    "AuthClientSecret": "ADMIN_CLIENT_SECRET"
  },
  "Markdown": {
    "MaxBase64ImageSizeBytes": 5242880,
    "AllowInsecureHttp": false,
    "AllowAllHttpsLinks": true,
    "AllowRelativeLinks": false
  },
  "WebPush": {
    "Subject": "mailto:dev@localhost",
    "PublicKey": "WEB_PUSH_PUBLIC_KEY",
    "PrivateKey": "WEB_PUSH_PRIVATE_KEY"
  },
  "TrustedProxies": "127.0.0.0/16"
}
