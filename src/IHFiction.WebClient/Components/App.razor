@inject IWebHostEnvironment Env
@inject Microsoft.Extensions.Options.IOptions<IHFiction.SharedWeb.Configuration.ApiUrlOptions> ApiUrlOptions
@using IHFiction.WebClient.Features.Reading
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="application-name" content="IHeartFiction" />
    <meta name="apple-mobile-web-app-title" content="I❤️Fiction" />

    @if (Activity.Current is { } currentActivity)
    {
        <meta name="traceparent" content="@currentActivity.Id" />
    }

    <base href="/" />

    <link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json" />
    <link rel="agent-skills" href="/.well-known/agent-skills/index.json" type="application/vnd.agentskills.v0.2.0+json" />
    @if (!string.IsNullOrEmpty(apiBaseUrl))
    {
        <link rel="oauth-protected-resource" href="@($"{apiBaseUrl}/.well-known/oauth-protected-resource")" />
        <link rel="service-desc" href="@($"{apiBaseUrl}/openapi/v1.json")" type="application/vnd.oai.openapi+json" />
        <link rel="service-doc" href="@($"{apiBaseUrl}/scalar/v1")" type="text/html" />
        <link rel="describedby" href="@($"{apiBaseUrl}/openapi/v1.json")" type="application/vnd.oai.openapi+json" />
    }
    <link rel="describedby" href="/auth.md" type="text/markdown" />

    <script src="@Assets["_content/IHFiction.SharedWeb/js/theme.js"]" nonce="@nonce"></script>
    
    <ResourcePreloader />

    <link href="@Assets["_content/IHFiction.SharedWeb/font-awesome/6.4.0/css/all.min.css"]" rel="stylesheet" nonce="@nonce" />
    <link href="@Assets["_content/IHFiction.SharedWeb/bulma/bulma.min.css"]" rel="stylesheet" nonce="@nonce" />
    <link href="@Assets["_content/IHFiction.SharedWeb/css/app.css"]" rel="stylesheet" nonce="@nonce" />
    <link href="@Assets["IHFiction.WebClient.styles.css"]" rel="stylesheet" nonce="@nonce" />

    <!-- Favicon -->
    <link href="@Assets["_content/IHFiction.SharedWeb/favicon/favicon.svg"]" rel="icon" type="image/svg+xml" />
    <link href="@Assets["_content/IHFiction.SharedWeb/favicon/favicon-96x96.png"]" rel="icon" type="image/png" sizes="96x96" />
    <link href="@Assets["_content/IHFiction.SharedWeb/favicon/favicon.ico"]" rel="shortcut icon" />
    <link href="@Assets["_content/IHFiction.SharedWeb/favicon/apple-touch-icon.png"]" rel="apple-touch-icon" sizes="180x180" />
    <link href="@Assets["_content/IHFiction.SharedWeb/favicon/site.webmanifest"]" rel="manifest" />

    <ImportMap integrity="@integrity" nonce="@nonce" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <SectionOutlet SectionName="app-head-noindex" @rendermode="InteractiveServer" />
    <SectionOutlet SectionName="app-head-metadata" @rendermode="InteractiveServer" />
    <SectionOutlet SectionName="app-head-structured-data" @rendermode="InteractiveServer" />
</head>

<body>
    <Routes Nonce="@nonce" IsMarkdownRequest="@isMarkdownRequest" @rendermode="InteractiveServer" />
    <ReconnectModal Nonce="@nonce" />
    <script src="@Assets["_framework/blazor.web.js"]" nonce="@nonce"></script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? integrity;
    private string? nonce;
    private string? apiBaseUrl;
    private bool isMarkdownRequest;

    protected override void OnInitialized()
    {
        apiBaseUrl = ApiUrlOptions.Value.BaseUrl?.ToString().TrimEnd('/');
        var hash = Convert.ToBase64String(SHA384.HashData(new UTF8Encoding().GetBytes(HttpContext?
        .GetEndpoint()?
        .Metadata
        .GetOrderedMetadata<ImportMapDefinition>()?
        .FirstOrDefault<ImportMapDefinition>()?
        .ToString()
        .ReplaceLineEndings("\n") ?? string.Empty)));

        integrity = $"sha384-{hash}";

        nonce = HttpContext?.Items.TryGetValue(HttpContextItemKey, out var nonceObj) == true && nonceObj is string value ? value : null;
        isMarkdownRequest = HttpContext?.Items.ContainsKey(MarkdownRequestNegotiator.HttpContextItemKey) ?? false;
    }
}
